<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account_reports.SalesReportFilterCode">
        <Dropdown>
            <button class="btn btn-secondary">
                <i class="fa fa-filter me-1"/> Codes: <t t-out="this.selectedECSaleType"/>
            </button>

            <t t-set-slot="content">
                <t t-foreach="this.controller.cachedFilterOptions.filter_sale_type_selection" t-as="saleType" t-key="saleType_index">
                    <DropdownItem
                        class="{ 'selected':  saleType.selected }"
                        onSelected="() => this.filterClicked({ optionKey: 'filter_sale_type_selection.'+ saleType_index + '.selected', reload: true})"
                        closingMode="'none'"
                        t-out="saleType.name"
                    />
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
