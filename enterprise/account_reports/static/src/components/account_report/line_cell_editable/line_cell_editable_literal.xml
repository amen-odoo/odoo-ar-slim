<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account_reports.AccountReportLineCellEditableLiteral">

        <t t-if="this.props.cell.auditable">
            <div class="content text-end cursor-pointer"
                 t-on-click.stop.capture="this.audit"
                 t-on-mousedown="this.onMouseDown"
            >
                <input type="text"
                       class="o_input w-100 text-end text-primary"
                       style="cursor: inherit;"
                       t-att-class="{'focused': this.isFocused}"
                       t-custom-ref="input"
                       t-on-change="this.onChange"
                       t-on-focus="this.onFocus"
                       t-on-blur="this.onBlur"
                       t-att-value="this.inputValue"
                />
            </div>
        </t>

        <t t-else="">
            <div class="content text-end"
                 t-on-mousedown="this.onMouseDown"
            >
                <input type="text"
                       class="o_input w-100 text-end text-body"
                       t-att-class="{
                           'focused': this.isFocused,
                           'cursor-default': !this.isFocused
                       }"
                       t-custom-ref="input"
                       t-on-change="this.onChange"
                       t-on-focus="this.onFocus"
                       t-on-blur="this.onBlur"
                       t-att-value="this.inputValue"
                />
            </div>
        </t>

        <i class="fa fa-pencil cursor-pointer"
           t-on-click.prevent.stop="this.onClickEdit"
           t-att-class="{'invisible': this.isFocused}"
        />

    </t>
</templates>
