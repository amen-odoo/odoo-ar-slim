<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account_reports.AccountReportEllipsis">
        <t t-call="{{ this.env.template('AccountReportEllipsis') }}"/>
    </t>

    <t t-name="account_reports.AccountReportEllipsisCustomizable">
        <t t-if="this.props.type === 'string'">
            <div class="name">
                <t t-out="(this.props.name) ? this.props.name.substring(0, this.props.maxCharacters) : ''"/>
            </div>

            <t t-if="this.triggersEllipsis">
                <button
                    class="btn btn_ellipsis"
                    t-on-click="(ev) => this.showEllipsisPopover(ev)"
                >
                    <i class="oi oi-ellipsis-h"/>
                </button>
            </t>
        </t>
        <t t-else="">
            <div class="name">
                <t t-out="this.props.name"/>
            </div>
        </t>
    </t>
</templates>
