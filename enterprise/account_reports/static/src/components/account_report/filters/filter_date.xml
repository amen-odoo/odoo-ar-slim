<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account_reports.AccountReportFilterDate">
        <Dropdown
            t-if="this.env.controller.cachedFilterOptions.report_id == this.dateFilterState.reportId"
            menuClass="'account_report_filter date'"
            navigationOptions="this.dateNavigationOptions"
        >
            <button class="btn btn-secondary">
                <i class="fa fa-calendar me-1"/>
                <t t-out="this.getDateDescription()"/>
            </button>

            <t t-set-slot="content">
                <t t-foreach="this.availableDateFiltersSorted" t-as="dateFilter" t-key="dateFilter.key">
                    <DropdownItem
                        t-if="this.isFilterVisible(dateFilter.key)"
                        tag="'div'"
                        class="{ 
                            'd-flex justify-content-between date_filter': true,
                            'date_filter_month': dateFilter.key === 'month',
                            'date_filter_quarter': dateFilter.key === 'quarter',
                            'date_filter_year': dateFilter.key === 'year',
                            'selected': this.isFilterDateSelected(dateFilter.key),
                        }"
                        attrs="{
                            'data-period-type': dateFilter.key,
                            'date-mode': this.isRangeMode ? 'range' : 'single'
                        }"
                        onSelected="() => this.selectDateFilter(dateFilter.key)"
                        closingMode="'none'"
                    >
                        <t t-if="dateFilter.key === 'today'" t-out="dateFilter.label"/>
                        <t t-else="">
                            <div class="filter_name" t-out="dateFilter.label"/>
                            <div class="d-flex justify-content-between">
                                <button
                                    class="btn_previous_date fa fa-caret-left"
                                    t-on-click="() => this.selectNewPeriod(dateFilter, -1)"
                                />
                                <t t-set="date_display" t-value="this.getFilterDateDisplay(dateFilter)"/>
                                <input
                                    class="o_input input_current_date"
                                    type="text"
                                    t-att-data-value="date_display"
                                    t-att-value="date_display"
                                    t-att="{'readonly': this.dateFilterState.editing !== dateFilter.key}"
                                    t-on-change="ev => this.writeDate(dateFilter, ev.target)"
                                />
                                <button
                                    class="btn_next_date fa fa-caret-right"
                                    t-on-click="() => this.selectNewPeriod(dateFilter, 1)"
                                />
                            </div>
                        </t>
                    </DropdownItem>
                </t>

                <div id="filter_date_divider_single" class="dropdown-divider"/>

                <DropdownItem
                    tag="'div'"
                    class="{
                        'date d-flex justify-content-between': true,
                        'selected': this.isFilterDateSelected('custom'),
                    }"
                    attrs="{
                        'data-period-type': 'custom',
                        'date-mode': this.isRangeMode ? 'range' : 'single'
                    }"
                    onSelected="() => this.selectDateFilter('custom')"
                    closingMode="'none'"
                >
                    <div t-if="!this.isRangeMode" class="filter_name">
                        Specific Date
                    </div>
                    <div t-else="" class="filter_name">
                        Custom Dates
                    </div>

                    <div
                        t-if="!this.isRangeMode and (this.isFilterDateSelected('custom') or this.isFilterDateSelected('year'))"
                        class="d-flex justify-content-center flex-grow-1"
                    >
                        <DateTimeInput
                            type="'date'"
                            class="'o-navigable'"
                            value="this.customDateTo"
                            onChange="(dateTo) => this.setCustomDateTo(dateTo)"
                        />
                    </div>

                    <div t-elif="this.isFilterDateSelected('custom') or this.isFilterDateSelected('year')" class="d-flex justify-content-center flex-grow-1">
                        <DateTimeInput
                            type="'date'"
                            class="'o-navigable'"
                            value="this.customDateFrom"
                            onChange="(dateFrom) => this.setCustomDateFrom(dateFrom)"
                        />
                        <span class="d-flex align-items-center">
                            to
                        </span>
                        <DateTimeInput
                            type="'date'"
                            class="'o-navigable'"
                            value="this.customDateTo"
                        onChange="(dateTo) => this.setCustomDateTo(dateTo)"
                        minDate="this.customDateFrom"
                        />
                    </div>
                </DropdownItem>

                <t t-if="this.reconDateFilterVisible">
                    <div id="filter_date_divider_single" class="dropdown-divider"/>
                    <DropdownItem
                        tag="'div'"
                        class="{
                            'date d-flex justify-content-between': true,
                            'selected': this.controller.options.recon_date?.date_to,
                        }"
                        onSelected="(ev) => this.reconDateFilterClicked(ev)"
                        closingMode="'none'"
                    >
                        <div class="filter_name">Open On</div>
                        <div
                            t-if="this.controller.options.recon_date"
                            class="d-flex justify-content-center flex-grow-1"
                        >
                            <DateTimeInput
                                type="'date'"
                                class="'o-navigable'"
                                value="this.reconDate"
                                onChange="(reconDateTo) => this.setReconDate(reconDateTo)"
                            />
                        </div>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
